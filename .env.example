# ===== nonebot2 服务 =====
# FastAPI driver 同时提供 HTTP 与 WebSocket 服务端（Lagrange 反向 WS 需要）
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# 置 1 时额外写 logs/bot.log（10MB 轮转，保留 10 份）
LOG_TO_FILE=0
# 命令前缀：既可用 /release，也可直接 release
COMMAND_START=["/", ""]

# ===== OneBot v11（Lagrange 反向 WS）=====
# 与 Lagrange 配置里的 AccessToken 保持一致；泄露等同于 bot 控制权，请勿外传
ONEBOT_ACCESS_TOKEN=请填入你的token

# ===== GitHub 监控 =====
# 私有仓库 owner/repo（依赖本机 gh auth login 的登录态）
GITHUB_REPO=owner/repo
# 轮询间隔（秒），默认 60
GITHUB_POLL_INTERVAL=60
# 一般无需修改；测试时可指向 tests/fake_gh/gh.py
#GITHUB_CLI_PATH=

# ===== 通知目标 =====
# JSON 数组格式（注意用方括号），群号与 QQ 号至少填一项
NOTIFY_GROUP_IDS=[123456789]
NOTIFY_USER_IDS=[1000000000]

# ===== 通知规则 =====
# nightly 排除规则：大小写不敏感的正则，命中 tag 或标题即不通知
NIGHTLY_EXCLUDE_REGEX=nightly
# 单轮轮询最多逐条展示的新提交数（更早的合并省略）
NOTIFY_MAX_COMMITS_PER_POLL=10
